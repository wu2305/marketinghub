    "build:lib": "node scripts/build-library.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "acorn": "^8.18.0",
    "acorn-jsx": "^5.3.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sirv": "^3.0.2",
    "storybook": "^10.6.1",
    "typescript": "^5.9.3",
    "vite": "^6.2.2",
    "vitest": "^4.1.11",
